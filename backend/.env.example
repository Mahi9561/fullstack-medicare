# Copy to .env and adjust. Nothing here is a real secret; this is a local-only app.
NODE_ENV=development
PORT=5000

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=medicare_local
DB_USER=root
DB_PASSWORD=
# Used by `npm test` and `sequelize-cli --env test`
DB_NAME_TEST=medicare_local_test

# Any string of 16+ characters. Change it if you like.
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=1d

CLIENT_URL=http://localhost:3000
